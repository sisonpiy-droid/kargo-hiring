# Copy to .env.local. Server-only secrets; .env.local is gitignored.
# Set the same values in Vercel > Settings > Environment Variables.

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# low (default, ~3x faster) | medium | high
GEMINI_THINKING=low

# Supabase > Project Settings > API. The service_role key is only ever read on the server.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

RESEND_API_KEY=
RESEND_FROM=Kargo Hiring <onboarding@resend.dev>
# Optional safety net: if set, every email goes here instead of the candidate's address.
TEST_RECIPIENT=

# Optional. If set, anyone opening the dashboard must type it once; if unset, it is open.
DASHBOARD_PASSCODE=

# Invite line: top N applicants per role who also score at least INVITE_THRESHOLD (out of 100).
TOP_N=5
INVITE_THRESHOLD=60
